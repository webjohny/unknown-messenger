# ---------- Core ----------
NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger_pass
POSTGRES_DB=messenger
# Змініть, якщо 5432 на хості вже зайнятий (значення має збігатися з DATABASE_URL).
POSTGRES_PORT=5432
DATABASE_URL=postgresql://messenger:messenger_pass@localhost:5432/messenger
# Локальний бутстрап схеми без міграцій. У проді ЗАВЖДИ false.
DB_SYNCHRONIZE=true

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---------- JWT (api-core) ----------
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- LiveKit ----------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_at_least_32_characters_long
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880

# ---------- Coturn ----------
TURN_REALM=messenger.local
TURN_USER=turnuser
TURN_PASSWORD=turnpass

# ---------- MinIO / S3 ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=messenger-media

# ---------- media-ai-service (Go) ----------
BOT_IDENTITY=silent-bot
STT_PROVIDER=mock            # mock | deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=uk
REDIS_TRANSCRIPT_CHANNEL=transcripts:final
REDIS_CONTROL_CHANNEL=media:control
REDIS_ROOM_EVENTS_CHANNEL=rooms:events

# ---------- Invite links ----------
# Origin the anonymous invite links point at. Falls back to the first CORS origin.
PUBLIC_WEB_URL=http://localhost:3000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
