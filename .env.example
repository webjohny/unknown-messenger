# ---------- Core ----------
NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger_pass
POSTGRES_DB=messenger
# Змініть, якщо 5432 на хості вже зайнятий (значення має збігатися з DATABASE_URL).
POSTGRES_PORT=5432
DATABASE_URL=postgresql://messenger:messenger_pass@localhost:5432/messenger
# Локальний бутстрап схеми без міграцій. У проді ЗАВЖДИ false.
DB_SYNCHRONIZE=true

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---------- JWT (api-core) ----------
# Обидва — по 32+ символи і РІЗНІ між собою; api-core не стартує інакше.
# Згенерувати:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- LiveKit ----------
# KEY — публічний ідентифікатор, SECRET — підпис join-токенів, 32+ символи.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880

# ---------- Coturn ----------
TURN_REALM=messenger.local
TURN_USER=turnuser
TURN_PASSWORD=turnpass

# ---------- MinIO / S3 ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=messenger-media

# ---------- media-ai-service (Go) ----------
BOT_IDENTITY=silent-bot
STT_PROVIDER=mock            # mock | deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=uk
REDIS_TRANSCRIPT_CHANNEL=transcripts:final
REDIS_CONTROL_CHANNEL=media:control
REDIS_ROOM_EVENTS_CHANNEL=rooms:events

# ---------- Invite links ----------
# Origin the anonymous invite links point at. Falls back to the first CORS origin.
PUBLIC_WEB_URL=http://localhost:3000

# ---------- Embed identity bridge ----------
# Optional. When set, POST /api/invites/:token/accept accepts a short-lived
# HMAC `assertion` (see apps/api-core/src/invites/external-identity.ts) so an
# embedder like cashflow-nestjs can hand a fresh guest their real display name
# instead of the random userNNNN. Leave empty to keep the embed flow fully
# anonymous. 32+ chars, generate with: openssl rand -base64 48
EXTERNAL_ASSERTION_SECRET=

# Origin allowed to frame /embed/* (CSP frame-ancestors + Permissions-Policy).
# Empty means /embed/* is not framable by anyone (same as the rest of the app).
EMBED_ALLOWED_ORIGIN=https://cash-come.com

# ---------- Frontend ----------
# Read by the web container at start and written into /config.js, so the image
# is built once and pointed anywhere. For `pnpm dev:web` these are unused —
# Vite picks up VITE_* from apps/web/.env.local, and the defaults below already
# match a local stack.
#
# Deliberately prefixed: LIVEKIT_URL above is api-core's own, and in production
# the two differ — the server dials the SFU inside the Docker network, the
# browser dials it through Traefik.
WEB_API_URL=http://localhost:4000
WEB_WS_URL=http://localhost:4000
WEB_LIVEKIT_URL=ws://localhost:7880
