{
  "name": "messenger",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:infra": "docker compose up -d postgres redis livekit minio minio-init",
    "dev:api": "pnpm --filter @messenger/api-core start:dev",
    "dev:web": "pnpm --filter @messenger/web dev",
    "dev:media": "cd apps/media-ai-service && go run ./cmd/bot",
    "db:migrate": "pnpm --filter @messenger/api-core prisma:migrate",
    "db:generate": "pnpm --filter @messenger/api-core prisma:generate",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
